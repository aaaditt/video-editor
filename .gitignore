node_modules/
dist/
out/

# Media files are never committed — only edit plans and transcripts are
input/*
!input/.gitkeep
remotion/public/jobs/**/*.mp4
remotion/public/jobs/**/*.wav
remotion/public/jobs/**/*.mov
remotion/public/jobs/**/*.mkv

# Regenerated per-job build artifacts
remotion/public/jobs/**/concat.txt
remotion/public/jobs/**/roughcut-probe.json
remotion/public/jobs/**/analysis.json

# User-supplied music (bundled SFX in assets/sfx ARE committed)
remotion/public/assets/music/*
!remotion/public/assets/music/README.md

# Whisper.cpp install + models (large binaries)
remotion/whisper.cpp/
